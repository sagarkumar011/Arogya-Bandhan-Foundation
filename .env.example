# ===============================================================
# AROGYA BANDHAN FOUNDATION - PRODUCTION & DEV CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials to GitHub.
# ===============================================================

# ---------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ---------------------------------------------------------------
# Production (Render, Supabase, Neon, Railway, AWS RDS):
DATABASE_URL="postgresql://username:password@hostname:5432/arogya_bandhan?schema=public"

# Local SQLite Zero-Config Development (Uncomment below for local test if preferred):
# DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ---------------------------------------------------------------
# Long random string for JWT token signing (e.g. generated via `openssl rand -base64 32`)
JWT_SECRET="your_secure_jwt_random_secret_string_minimum_32_chars"

# ---------------------------------------------------------------
# 3. PAYMENT GATEWAY (Razorpay)
# ---------------------------------------------------------------
# Razorpay dashboard API keys (Test or Live)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# ---------------------------------------------------------------
# 4. MEDIA STORAGE (Cloudinary / S3)
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ---------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (SMTP)
# ---------------------------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="contact@arogyabandhan.org"
EMAIL_PASSWORD="your_email_app_password"
EMAIL_FROM="Arogya Bandhan Foundation <contact@arogyabandhan.org>"

# ---------------------------------------------------------------
# 6. APPLICATION & API URLS
# ---------------------------------------------------------------
# Production Frontend Domain (e.g., https://arogyabandhan.org or Vercel URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Endpoint Base URL (Defaults to /api for Next.js internal routes)
NEXT_PUBLIC_API_URL="/api"

# ---------------------------------------------------------------
# 7. BACKEND SERVER CONFIGURATION (Render / Standalone Express)
# ---------------------------------------------------------------
# Port for the standalone backend server (Render sets process.env.PORT automatically)
PORT=5000

# Allowed CORS origins for standalone backend
CORS_ORIGIN="http://localhost:3000,https://arogyabandhan.org"
