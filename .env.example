# ===============================================================
# AROGYA BANDHAN FOUNDATION - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure for local or production use.
# NEVER commit .env with real credentials to GitHub.
# ===============================================================

# 1. DATABASE (PostgreSQL for production; or SQLite file:./dev.db for local)
DATABASE_URL="postgresql://username:password@hostname:5432/arogya_bandhan?schema=public"

# 2. AUTHENTICATION & SECURITY
JWT_SECRET="your_secure_jwt_random_secret_string_minimum_32_chars"

# 3. PAYMENT GATEWAY (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# 4. MEDIA STORAGE (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 5. TRANSACTIONAL EMAIL (SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="contact@arogyabandhan.org"
EMAIL_PASSWORD="your_email_app_password"
EMAIL_FROM="Arogya Bandhan Foundation <contact@arogyabandhan.org>"

# 6. APPLICATION & CANONICAL URLS
# In production (e.g. on Render), set these to your live domain:
NEXT_PUBLIC_SITE_URL="https://your-service-name.onrender.com"
NEXT_PUBLIC_APP_URL="https://your-service-name.onrender.com"
NEXT_PUBLIC_API_URL="https://your-service-name.onrender.com"

# 7. CORS SETTINGS
CORS_ORIGIN="https://your-service-name.onrender.com"
