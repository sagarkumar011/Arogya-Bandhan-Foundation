# ===============================================================
# AROGYA BANDHAN FOUNDATION - ENVIRONMENT VARIABLES TEMPLATE
# ===============================================================

# ---------------------------------------------------------------
# RENDER BACKEND / PRODUCTION ENVIRONMENT VARIABLES
# Set these in your Render Web Service Dashboard
# ---------------------------------------------------------------

# Database: Managed PostgreSQL Connection String
DATABASE_URL="postgresql://username:password@hostname:5432/arogya_bandhan?schema=public"

# Authentication: Secure JWT Secret (min 32 characters)
JWT_SECRET="your_secure_jwt_random_secret_string_minimum_32_chars"

# Demo Login Flag (true to allow demo login, false for database-only auth)
ENABLE_DEMO_LOGIN="true"

# Server Port (Render sets this dynamically; defaults to 5000)
PORT="5000"

# CORS Origin: Set to your live Vercel domain in production
# Example: https://arogya-bandhan-foundation.vercel.app
CORS_ORIGIN="https://your-frontend.vercel.app"

# Application URL
NEXT_PUBLIC_SITE_URL="https://your-frontend.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-frontend.vercel.app"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Transactional Email (SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="aarogyabandhanfoundation@gmail.com"
EMAIL_PASSWORD="your_email_app_password"
EMAIL_FROM="Arogya Bandhan Foundation <aarogyabandhanfoundation@gmail.com>"

# ---------------------------------------------------------------
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# Set these in your Vercel Project Dashboard
# ---------------------------------------------------------------

# Render Backend URL (The live public URL of your Render Express backend)
# Example: https://arogya-backend.onrender.com
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://your-frontend.vercel.app"
